{
    "name": "saurabhgayali/pdbviewerphp",
    "description": "A PHP library for embedding interactive molecular structure viewers using 3Dmol.js",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Saurabh Gayali",
            "email": "author@example.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PDBViewerPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDBViewerPHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
